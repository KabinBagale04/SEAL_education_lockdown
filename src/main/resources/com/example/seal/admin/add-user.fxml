<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.seal.controller.admin.AddUserController"
      styleClass="page"
      stylesheets="@../css/admin.css">

    <padding>
        <Insets top="35"
                right="40"
                bottom="35"
                left="40"/>
    </padding>

    <top>
        <VBox spacing="20">
            <BorderPane.margin>
                <Insets bottom="20"/>
            </BorderPane.margin>
            <Label text="Add User" styleClass="page-title"/>
            <Label text="Create a Teacher or Student account"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16"
              maxWidth="Infinity"
              maxHeight="Infinity"
              styleClass="form-card">

        <VBox spacing="6">
            <Label text="Full Name"
                   styleClass="field-label"/>

            <TextField fx:id="fullNameField"
                       promptText="Enter full name"
                       styleClass="admin-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Username"
                   styleClass="field-label"/>

            <TextField fx:id="usernameField"
                       promptText="Enter username"
                       styleClass="admin-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Password"
                   styleClass="field-label"/>

            <PasswordField fx:id="passwordField"
                           promptText="Enter initial password"
                           styleClass="admin-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Role"
                   styleClass="field-label"/>

            <ComboBox fx:id="roleComboBox"
                      promptText="Select role"
                      maxWidth="Infinity"
                      styleClass="admin-field"/>
        </VBox>

        <Label fx:id="messageLabel"
               text=""
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="error-message"/>

        <HBox spacing="12">
            <Button text="Create User"
                    styleClass="primary-button"
                    onAction="#handleCreateUser"/>

            <Button text="Cancel"
                    styleClass="secondary-button"
                    onAction="#handleCancel"/>
        </HBox>

        </VBox>
    </center>
</BorderPane>

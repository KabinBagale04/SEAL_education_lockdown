<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane ?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@css/login.css"
            fx:controller="com.example.seal.controller.LoginController">
    <!--style sheet le css connect garxa and fx controller le java sanga, the one we use to control the behavior of the application-->
    <!--so basically we are using a border layout, yo mathi ko broderpane le describe gareko
     and border le 5 section ma branch garxa and we use top for our logo-->
    <top>
        <!--hbox is horizontal box and a container the other is a veritcal VBox
         spacing venrko distance between two child nodes or yesko adjacent vanda 10 pixels tada basxa-->
        <HBox spacing = "10">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            <Label text="SEAL"
            styleClass="brand-title"/>
        </HBox>
    </top>
    <!--now aba we use center section of border pane as login section is better in the middle and we nest multiple vbox and hbox to make it look better  -->
    <center>
        <!-- Stack pane vaneko like stack in a cylinder format down to up style ma -->
        <StackPane>
            <VBox alignment="CENTER"
            spacing="15"
            maxWidth="400">
                <Label text="Login to SEAL"
                styleClass="login-title"/>
                <Label text="Secured Examination Access and Lockdown"
                styleClass="Login-subtitle"/>

                <!--
                <HBox alignment = "CENTER"
                spacing = "20">
                    Radio button vaneko group ma hunxa and only one can be selected so java ma radio button banako jastai ho

                    <RadioButton fx:id="studentRadio"
                                 text = "Student"
                                 selected="true"
                                 styleClass="role-selector"
                                 >
                        <toggleGroup>
                            <ToggleGroup fx:id="roleGroup"/>
                        </toggleGroup>
                    </RadioButton>

                    <RadioButton fx:id="teacherRadio"
                                 text = "Teacher"
                                 toggleGroup="$roleGroup"
                                 styleClass="role-selector"

                                 />
                </HBox>
            -->

                <VBox>
                    <Label text = "Username"/>
                    <TextField promptText="Enter your username"
                    styleClass="login-field"
                    fx:id="usernameField"/>
                </VBox>

                <VBox>
                    <Label text = "Password"/>
                    <PasswordField promptText="Enter your password"
                    styleClass="login-field"
                    fx:id="passwordField"/>
                </VBox>

                <Label fx:id="messageLabel"
                       text=""
                       visible = "false"
                       managed = "false"
                       wrapText="true"
                       styleClass="error-message"/>

                <HBox spacing = "15"
                      alignment = "CENTER">
                    <Button text="Login"
                    styleClass="login-button"
                    onAction="#handleLogin"/>
                    <Button text="Clear"
                    styleClass="clear-button"
                    onAction="#handleClear"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
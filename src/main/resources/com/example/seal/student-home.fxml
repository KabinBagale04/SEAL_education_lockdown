<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.seal.controller.student.StudentShellController"
            styleClass="student-root" stylesheets="@css/student.css">
    <top>
        <HBox styleClass="student-header" spacing="20" alignment="CENTER_LEFT">
            <Label text="SEAL" styleClass="brand"/>
            <Label text="Student" styleClass="secondary"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="fullName" maxWidth="300" textOverrun="ELLIPSIS"/>
            <Button text="Sign out" onAction="#logout"/>
        </HBox>
    </top>
    <left>
        <VBox styleClass="student-sidebar" minWidth="180" prefWidth="180" maxWidth="180" spacing="8">
            <Label text="WORKSPACE" styleClass="sidebar-caption"/>
            <ToggleButton fx:id="dashboardButton" text="Dashboard" onAction="#dashboard" styleClass="student-nav" maxWidth="Infinity"/>
            <ToggleButton fx:id="examsButton" text="Exams" onAction="#exams" styleClass="student-nav" maxWidth="Infinity"/>
            <ToggleButton fx:id="resultsButton" text="Results" onAction="#results" styleClass="student-nav" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center><StackPane fx:id="contentArea"/></center>
</BorderPane>

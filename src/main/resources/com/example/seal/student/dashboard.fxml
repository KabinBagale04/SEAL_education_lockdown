<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.seal.controller.student.StudentDashboardController"
            fitToWidth="true" hbarPolicy="NEVER">
    <content>
        <VBox spacing="24" styleClass="page">
            <Label text="Dashboard" styleClass="page-title"/>
            <FlowPane hgap="16" vgap="16" prefWrapLength="780">
                <VBox fx:id="pastPapers" styleClass="dashboard-tile" minWidth="200" prefWidth="200" maxWidth="200" minHeight="190" prefHeight="190" spacing="12">
                    <Label text="Past papers" styleClass="section-title"/>
                    <Label text="Paper archive" styleClass="secondary"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Coming soon" styleClass="future-label"/>
                </VBox>
                <VBox styleClass="dashboard-tile" minWidth="200" prefWidth="200" maxWidth="200" minHeight="190" prefHeight="190" spacing="12">
                    <Label text="Examinations" styleClass="section-title"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="Open exams" onAction="#exams" styleClass="primary" maxWidth="Infinity"/>
                </VBox>
                <VBox styleClass="dashboard-tile" minWidth="200" prefWidth="200" maxWidth="200" minHeight="190" prefHeight="190" spacing="12">
                    <Label text="My results" styleClass="section-title"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button text="View results" onAction="#results" maxWidth="Infinity"/>
                </VBox>
            </FlowPane>
        </VBox>
    </content>
</ScrollPane>

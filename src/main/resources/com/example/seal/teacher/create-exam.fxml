<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="exam-scroll"
fx:controller="com.example.seal.controller.teacher.CreateExamController">

    <content>

        <VBox spacing="24"
              styleClass="create-exam-page">

            <padding>
                <Insets top="30"
                        right="35"
                        bottom="35"
                        left="35"/>
            </padding>

            <HBox alignment="CENTER_LEFT">

                <VBox spacing="4">

                    <Label text="Create Examination"
                           styleClass="page-title"/>

                    <Label text="Configure the examination details and questions."
                           styleClass="page-subtitle"/>

                </VBox>

            </HBox>

            <Separator/>

            <VBox spacing="18"
                  styleClass="form-card">

                <Label text="Exam Details"
                       styleClass="section-title"/>

                <VBox spacing="6">

                    <Label text="Examination Title"
                           styleClass="form-label"/>

                    <TextField fx:id="titleField"
                               promptText="e.g. Data Structures Midterm"
                               styleClass="form-field"/>

                </VBox>

                <HBox spacing="15">

                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity">

                        <Label text="Subject"
                               styleClass="form-label"/>

                        <TextField fx:id="subjectField"
                                   promptText="e.g. Data Structures"
                                   styleClass="form-field"/>

                    </VBox>


                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS"
                          maxWidth="Infinity">

                        <Label text="Subject Code"
                               styleClass="form-label"/>

                        <TextField fx:id="subjectCodeField"
                                   promptText="e.g. BIT 405 CO"
                                   styleClass="form-field"/>

                    </VBox>

                </HBox>

                <VBox spacing="6">

                    <Label text="Duration"
                           styleClass="form-label"/>

                    <HBox alignment="CENTER_LEFT"
                          spacing="10">

                        <TextField fx:id="durationField"
                                   promptText="60"
                                   prefWidth="100"
                                   maxWidth="100"
                                   styleClass="form-field"/>

                        <Label text="minutes"
                               styleClass="field-hint"/>

                    </HBox>

                </VBox>

                <VBox spacing="6">

                    <Label text="Instructions"
                           styleClass="form-label"/>

                    <TextArea fx:id="instructionsArea"
                              promptText="Enter instructions for students..."
                              prefRowCount="4"
                              wrapText="true"
                              styleClass="form-text-area"/>

                </VBox>

            </VBox>

            <VBox spacing="15"
                  styleClass="form-card">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label text="Questions"
                               styleClass="section-title"/>

                        <Label text="Add multiple-choice questions to this examination."
                               styleClass="page-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ Add Question"
                            styleClass="secondary-action-button"
                            onAction="#handleAddQuestion"/>

                </HBox>


                <VBox fx:id="questionsContainer"
                      spacing="15">

                    <VBox fx:id="emptyQuestionsState"
                          alignment="CENTER"
                          spacing="6"
                          styleClass="question-empty-state">

                        <padding>
                            <Insets top="30"
                                    right="20"
                                    bottom="30"
                                    left="20"/>
                        </padding>

                        <Label text="No questions added yet."
                               styleClass="empty-title"/>

                        <Label text="Add an MCQ or textual question to this examination."
                               styleClass="page-subtitle"/>

                    </VBox>

                </VBox>

            </VBox>

            <Label fx:id="formMessageLabel"
                   visible="false"
                   managed="false"
                   wrapText="true"
                   styleClass="form-error"/>

            <HBox alignment="CENTER_RIGHT"
                  spacing="10">

                <Button text="Cancel" onAction="#cancel"
                        styleClass="cancel-button"/>

                <Button text="Save Draft"
                        styleClass="secondary-action-button"
                onAction="#handleSaveDraft"/>

                <Button text="Publish Exam"
                        styleClass="primary-button"
                onAction="#handlePublish"/>

            </HBox>

        </VBox>

    </content>

</ScrollPane>

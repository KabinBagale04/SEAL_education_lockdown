<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.seal.controller.teacher.QuestionEditorController"
      styleClass="question-card"
      spacing="16">
    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <HBox alignment="CENTER">
        <Label fx:id="questionNumberLabel"
               text="Question 1"
               styleClass="question-number"/>
        <Region HBox.hgrow="ALWAYS"/>

        <HBox alignment="CENTER"
              spacing="10">
            <Label text="Type"
                   styleClass="form-label"/>

            <ComboBox fx:id="questionTypeBox"
                      prefWidth="180"
            styleClass="question-type-box"/>
        </HBox>
    </HBox>

    <VBox spacing="6">
        <Label text="Question"
               styleClass="form-label"/>

        <TextArea fx:id="questionTextArea"
                  promptText="Enter the question..."
                  prefRowCount="2"
                  wrapText="true"
                  styleClass="form-text-area"/>
    </VBox>

    <VBox fx:id="typeSpecificArea"
          spacing="12"/>
    <!-- left to be added now-->

    <HBox alignment="CENTER">
        <HBox alignment="CENTER"
              spacing="10">
            <Label text="Marks"
                   styleClass="form-label"/>
            <TextField fx:id="marksField"
                       text="1"
                       prefWidth="80"
                       maxWidth="80"
                       styleClass="form-field"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Delete"
                styleClass="delete-button"
                onAction="#handleDelete"/>
    </HBox>
</VBox>

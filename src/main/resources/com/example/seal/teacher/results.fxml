<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.geometry.Insets?>
<VBox fx:id="root" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.seal.controller.teacher.ResultsController" spacing="12">
 <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
 <Label text="Submissions and grading" styleClass="page-title"/>
 <HBox spacing="12"><ComboBox fx:id="exams" prefWidth="400" maxWidth="Infinity" HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh"/></HBox>
 <TableView fx:id="table" prefHeight="180" minHeight="120" >
  <columns><TableColumn fx:id="studentColumn" text="Student" prefWidth="240"/><TableColumn fx:id="statusColumn" text="Status"/><TableColumn fx:id="scoreColumn" text="Score"/></columns>
 </TableView>
 <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"><content><VBox fx:id="answers" spacing="12"><padding><Insets top="12" right="12" bottom="12" left="12"/></padding></VBox></content></ScrollPane>
 <Label fx:id="message" wrapText="true" styleClass="form-error"/>
 <Button fx:id="save" text="Save text grades" styleClass="primary-button" onAction="#grade"/>
</VBox>

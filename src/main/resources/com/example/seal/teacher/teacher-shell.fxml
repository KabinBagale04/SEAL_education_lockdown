<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="400.0" prefWidth="600.0"
            fx:controller="com.example.seal.controller.teacher.TeacherShellController"
            styleClass="teacher-shell"
            stylesheets="@../css/teacher.css">

        <top>
            <HBox alignment = "CENTER"
                  spacing = "12"
                  styleClass="teacher-header">
                <padding>
                    <Insets top="15"
                            right="25"
                            bottom="15"
                            left="25"/>
                </padding>

                <Label text = "SEAL"
                styleClass="teacher-brand"/>
                <!--yo hgrow le chai seal ra aaru button ko center ma available space consume garxa -->
                <Region HBox.hgrow="ALWAYS"/>
                <Label text = "Teacher"
                styleClass="teacher-role"/>
                <Button text="Logout"
                styleClass="logout-button"
                onAction="#handleLogout"/>
            </HBox>
        </top>

        <left>
            <VBox fx:id="sidebar"
                  minWidth="75"
                  prefWidth="210"
                  maxWidth="210"
                  spacing="8"
                  styleClass="teacher-sidebar">
                <padding>
                    <Insets top="25"
                            right="15"
                            bottom="25"
                            left="15"/>
                </padding>
                <Button text="☰"
                        styleClass="menu-button"
                        onAction="#toggleSidebar"/>

                <Button fx:id="dashboardButton"
                        text="Dashboard"
                        styleClass="nav-button"
                onAction="#showDashboard"/>
                <Button fx:id="examsButton"
                        text="Exams"
                        styleClass="nav-button"
                onAction="#showExams"/>
                <Button fx:id="resultsButton"
                        text="Results"
                        styleClass="nav-button"
                onAction="#showResults"/>
            </VBox>


        </left>

        <center>
            <StackPane fx:id="contentArea"
            styleClass="teacher-content"/>
        </center>
</BorderPane>
